{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "buildCommand": "npm ci && npm run build",
  "outputDirectory": "public",
  "functions": {
    "app.py": {
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,tests/**,.runtime/**,.venv/**,database/**}"
    }
  }
}
